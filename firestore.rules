rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidNote(data, userId) {
      return data.keys().hasAll([
               'userId', 'title', 'content', 'category',
               'colorIndex', 'pinned', 'reminderEpochMillis',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'title', 'content', 'category',
               'colorIndex', 'pinned', 'reminderEpochMillis',
               'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.content is string && data.content.size() <= 10000 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.colorIndex is int && data.colorIndex >= 0 && data.colorIndex <= 5 &&
             data.pinned is bool &&
             data.reminderEpochMillis is int && data.reminderEpochMillis >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidScheduleItem(data, userId) {
      return data.keys().hasAll([
               'userId', 'title', 'description', 'dateKey',
               'startTime', 'endTime', 'priority', 'completed',
               'reminderEnabled', 'reminderEpochMillis',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'title', 'description', 'dateKey',
               'startTime', 'endTime', 'priority', 'completed',
               'reminderEnabled', 'reminderEpochMillis',
               'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.description is string && data.description.size() <= 2000 &&
             data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.startTime is string && data.startTime.size() == 5 && data.startTime.matches('^[0-9]{2}:[0-9]{2}$') &&
             data.endTime is string && data.endTime.size() == 5 && data.endTime.matches('^[0-9]{2}:[0-9]{2}$') &&
             data.priority is string && (data.priority == 'HIGH' || data.priority == 'MEDIUM' || data.priority == 'LOW') &&
             data.completed is bool &&
             data.reminderEnabled is bool &&
             data.reminderEpochMillis is int && data.reminderEpochMillis >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserSettings(data, userId) {
      return data.keys().hasAll([
               'userId', 'themeMode', 'paletteName',
               'notificationsEnabled', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'themeMode', 'paletteName',
               'notificationsEnabled', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             data.themeMode is string && (data.themeMode == 'SYSTEM' || data.themeMode == 'LIGHT' || data.themeMode == 'DARK') &&
             data.paletteName is string && (
               data.paletteName == 'INDIGO' ||
               data.paletteName == 'EMERALD' ||
               data.paletteName == 'AMBER' ||
               data.paletteName == 'ROSE' ||
               data.paletteName == 'OCEAN'
             ) &&
             data.notificationsEnabled is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(noteId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(noteId) &&
                         isValidNote(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(noteId) &&
                         isValidNote(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'content', 'category', 'colorIndex',
                           'pinned', 'reminderEpochMillis', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(noteId);
      }

      match /scheduleItems/{itemId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(itemId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(itemId) &&
                         isValidScheduleItem(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(itemId) &&
                         isValidScheduleItem(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'description', 'dateKey', 'startTime',
                           'endTime', 'priority', 'completed',
                           'reminderEnabled', 'reminderEpochMillis', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(itemId);
      }

      match /settings/{settingId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(settingId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(settingId) &&
                         isValidUserSettings(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(settingId) &&
                         isValidUserSettings(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'themeMode', 'paletteName', 'notificationsEnabled', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(settingId);
      }
    }
  }
}
