rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMemberProfile(data, memberId) {
      return data.keys().hasAll([
               'memberId', 'nickname', 'statusText',
               'avatarType', 'avatarData', 'colorIndex',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'memberId', 'nickname', 'statusText',
               'avatarType', 'avatarData', 'colorIndex',
               'createdAt', 'updatedAt'
             ]) &&
             data.memberId is string && data.memberId == memberId && isValidId(data.memberId) &&
             data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 40 &&
             data.statusText is string && data.statusText.size() <= 80 &&
             data.avatarType is string && (data.avatarType == 'PRESET' || data.avatarType == 'PHOTO') &&
             data.avatarData is string && data.avatarData.size() >= 1 && data.avatarData.size() <= 35000 &&
             data.colorIndex is int && data.colorIndex >= 0 && data.colorIndex <= 5 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSharedNote(data) {
      return data.keys().hasAll([
               'title', 'content', 'category',
               'colorIndex', 'pinned', 'reminderEpochMillis',
               'authorId', 'authorName', 'authorAvatarType',
               'authorAvatarData', 'authorColorIndex',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'title', 'content', 'category',
               'colorIndex', 'pinned', 'reminderEpochMillis',
               'authorId', 'authorName', 'authorAvatarType',
               'authorAvatarData', 'authorColorIndex',
               'createdAt', 'updatedAt'
             ]) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.content is string && data.content.size() <= 10000 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.colorIndex is int && data.colorIndex >= 0 && data.colorIndex <= 5 &&
             data.pinned is bool &&
             data.reminderEpochMillis is int && data.reminderEpochMillis >= 0 &&
             data.authorId is string && isValidId(data.authorId) &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 40 &&
             data.authorAvatarType is string && (data.authorAvatarType == 'PRESET' || data.authorAvatarType == 'PHOTO') &&
             data.authorAvatarData is string && data.authorAvatarData.size() >= 1 && data.authorAvatarData.size() <= 35000 &&
             data.authorColorIndex is int && data.authorColorIndex >= 0 && data.authorColorIndex <= 5 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSharedScheduleItem(data) {
      return data.keys().hasAll([
               'title', 'description', 'dateKey',
               'startTime', 'endTime', 'priority', 'completed',
               'reminderEnabled', 'reminderEpochMillis',
               'authorId', 'authorName', 'authorAvatarType',
               'authorAvatarData', 'authorColorIndex',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'title', 'description', 'dateKey',
               'startTime', 'endTime', 'priority', 'completed',
               'reminderEnabled', 'reminderEpochMillis',
               'authorId', 'authorName', 'authorAvatarType',
               'authorAvatarData', 'authorColorIndex',
               'createdAt', 'updatedAt'
             ]) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.description is string && data.description.size() <= 2000 &&
             data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.startTime is string && data.startTime.size() == 5 && data.startTime.matches('^[0-9]{2}:[0-9]{2}$') &&
             data.endTime is string && data.endTime.size() == 5 && data.endTime.matches('^[0-9]{2}:[0-9]{2}$') &&
             data.priority is string && (data.priority == 'HIGH' || data.priority == 'MEDIUM' || data.priority == 'LOW') &&
             data.completed is bool &&
             data.reminderEnabled is bool &&
             data.reminderEpochMillis is int && data.reminderEpochMillis >= 0 &&
             data.authorId is string && isValidId(data.authorId) &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 40 &&
             data.authorAvatarType is string && (data.authorAvatarType == 'PRESET' || data.authorAvatarType == 'PHOTO') &&
             data.authorAvatarData is string && data.authorAvatarData.size() >= 1 && data.authorAvatarData.size() <= 35000 &&
             data.authorColorIndex is int && data.authorColorIndex >= 0 && data.authorColorIndex <= 5 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /shared_members/{memberId} {
      allow get: if isValidId(memberId);
      allow list: if true;
      allow create: if isValidId(memberId) && isValidMemberProfile(incoming(), memberId);
      allow update: if isValidId(memberId) &&
                       isValidMemberProfile(incoming(), memberId) &&
                       incoming().memberId == existing().memberId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'nickname', 'statusText', 'avatarType',
                         'avatarData', 'colorIndex', 'updatedAt'
                       ]);
      allow delete: if isValidId(memberId);
    }

    match /shared_notes/{noteId} {
      allow get: if isValidId(noteId);
      allow list: if true;
      allow create: if isValidId(noteId) && isValidSharedNote(incoming());
      allow update: if isValidId(noteId) &&
                       isValidSharedNote(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'content', 'category', 'colorIndex',
                         'pinned', 'reminderEpochMillis',
                         'authorId', 'authorName', 'authorAvatarType',
                         'authorAvatarData', 'authorColorIndex', 'updatedAt'
                       ]);
      allow delete: if isValidId(noteId);
    }

    match /shared_schedule/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create: if isValidId(itemId) && isValidSharedScheduleItem(incoming());
      allow update: if isValidId(itemId) &&
                       isValidSharedScheduleItem(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'description', 'dateKey', 'startTime',
                         'endTime', 'priority', 'completed',
                         'reminderEnabled', 'reminderEpochMillis',
                         'authorId', 'authorName', 'authorAvatarType',
                         'authorAvatarData', 'authorColorIndex', 'updatedAt'
                       ]);
      allow delete: if isValidId(itemId);
    }
  }
}
