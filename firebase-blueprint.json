{
  "entities": {
    "MemberProfile": {
      "title": "MemberProfile",
      "description": "A participant profile in the shared ChronoNote workspace with custom nickname, status, preset or gallery photo avatar, and badge color.",
      "type": "object",
      "properties": {
        "memberId": {
          "type": "string",
          "description": "Unique identifier of the participant."
        },
        "nickname": {
          "type": "string",
          "description": "Display nickname chosen by the participant (1 to 40 characters)."
        },
        "statusText": {
          "type": "string",
          "description": "Custom status or bio line (0 to 80 characters)."
        },
        "avatarType": {
          "type": "string",
          "enum": ["PRESET", "PHOTO"],
          "description": "Whether the avatar is a preset icon or a compressed gallery photo."
        },
        "avatarData": {
          "type": "string",
          "description": "Preset key or Base64-encoded 128x128 thumbnail."
        },
        "colorIndex": {
          "type": "integer",
          "description": "Accent badge color index (0 to 5)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "memberId",
        "nickname",
        "statusText",
        "avatarType",
        "avatarData",
        "colorIndex",
        "createdAt",
        "updatedAt"
      ]
    },
    "SharedNote": {
      "title": "SharedNote",
      "description": "A shared note in the built-in workspace with author profile attribution, category, color card, pin state, and reminder.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Note title (1 to 150 characters)."
        },
        "content": {
          "type": "string",
          "description": "Note content (0 to 10000 characters)."
        },
        "category": {
          "type": "string",
          "description": "Category tag (1 to 40 characters)."
        },
        "colorIndex": {
          "type": "integer",
          "description": "Card color index (0 to 5)."
        },
        "pinned": {
          "type": "boolean",
          "description": "Whether the note is pinned to the top."
        },
        "reminderEpochMillis": {
          "type": "integer",
          "description": "Epoch milliseconds for reminder notification."
        },
        "authorId": {
          "type": "string",
          "description": "Member ID of the author or last editor."
        },
        "authorName": {
          "type": "string",
          "description": "Nickname of the author."
        },
        "authorAvatarType": {
          "type": "string",
          "enum": ["PRESET", "PHOTO"],
          "description": "Avatar type of the author."
        },
        "authorAvatarData": {
          "type": "string",
          "description": "Avatar preset ID or Base64 thumbnail of the author."
        },
        "authorColorIndex": {
          "type": "integer",
          "description": "Badge color index of the author (0 to 5)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "title",
        "content",
        "category",
        "colorIndex",
        "pinned",
        "reminderEpochMillis",
        "authorId",
        "authorName",
        "authorAvatarType",
        "authorAvatarData",
        "authorColorIndex",
        "createdAt",
        "updatedAt"
      ]
    },
    "SharedScheduleItem": {
      "title": "SharedScheduleItem",
      "description": "A shared daily schedule / calendar item with author attribution, time slot, priority, completion state, and reminder.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Task or event title (1 to 150 characters)."
        },
        "description": {
          "type": "string",
          "description": "Task description (0 to 2000 characters)."
        },
        "dateKey": {
          "type": "string",
          "description": "ISO date YYYY-MM-DD."
        },
        "startTime": {
          "type": "string",
          "description": "Start time HH:mm."
        },
        "endTime": {
          "type": "string",
          "description": "End time HH:mm."
        },
        "priority": {
          "type": "string",
          "enum": ["HIGH", "MEDIUM", "LOW"],
          "description": "Priority level."
        },
        "completed": {
          "type": "boolean",
          "description": "Completion status."
        },
        "reminderEnabled": {
          "type": "boolean",
          "description": "Whether push reminder is enabled."
        },
        "reminderEpochMillis": {
          "type": "integer",
          "description": "Epoch milliseconds for reminder."
        },
        "authorId": {
          "type": "string",
          "description": "Member ID of the author."
        },
        "authorName": {
          "type": "string",
          "description": "Nickname of the author."
        },
        "authorAvatarType": {
          "type": "string",
          "enum": ["PRESET", "PHOTO"],
          "description": "Avatar type of the author."
        },
        "authorAvatarData": {
          "type": "string",
          "description": "Avatar preset ID or Base64 thumbnail of the author."
        },
        "authorColorIndex": {
          "type": "integer",
          "description": "Badge color index of the author (0 to 5)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "title",
        "description",
        "dateKey",
        "startTime",
        "endTime",
        "priority",
        "completed",
        "reminderEnabled",
        "reminderEpochMillis",
        "authorId",
        "authorName",
        "authorAvatarType",
        "authorAvatarData",
        "authorColorIndex",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/shared_members/{memberId}": {
      "schema": { "$ref": "#/entities/MemberProfile" },
      "description": "Shared workspace participants with custom nicknames and avatars."
    },
    "/shared_notes/{noteId}": {
      "schema": { "$ref": "#/entities/SharedNote" },
      "description": "Shared workspace notes accessible to all participants with equal rights."
    },
    "/shared_schedule/{itemId}": {
      "schema": { "$ref": "#/entities/SharedScheduleItem" },
      "description": "Shared workspace daily calendar schedule items accessible to all participants."
    }
  }
}
